# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.venv/
venv/

# Environment
.env
.env.*
!.env.example
!.env.worker.example
*.session
*.session-journal
servers.yaml
# agents.yaml is deliberately NOT ignored: it is the shared org chart (role,
# owns, escalates_to, budgets) and has to travel with a deploy. It carries
# placeholder usernames following the <name>agnt scheme, which
# test_public_surface enforces, so no real handle can reach the public repo.
# Per-installation identity overlay (real Telegram @usernames) — never public.
agents.local.yaml

# Data
data/
workspace/
*.db
*.sqlite
*.log

# Local agent workspaces are runtime state. Keep only public templates/docs.
workspaces/*
!workspaces/README.md
!workspaces/_template/
!workspaces/_template/**

# IDE
.idea/
.vscode/
*.swp

# OS
.DS_Store
Thumbs.db
dashboard-ui/node_modules/
dashboard-ui/.vite/
dashboard-ui/dist/

